{
  "name": "tessera",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests tools",
    "test": "vitest run",
    "test:invariants": "vitest run tests/invariants",
    "e2e": "node tools/e2e.mjs",
    "gates": "npm run typecheck && npm run lint && npm run test && npm run build && npm run e2e",
    "verify": "npm run gates",
    "certify:web": "npm run verify && slu-certify web",
    "certify:mobile": "npm run verify && slu-certify mobile",
    "certify:controller": "npm run verify && slu-certify controller",
    "certify:release": "npm run verify && slu-certify release",
    "sweep": "vitest run --config vitest.sweep.config.ts"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.6",
    "@fontsource/jetbrains-mono": "^5.2.6",
    "@slu/web-shell": "file:vendor/slu-web-shell",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.30.0",
    "playwright": "1.63.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}